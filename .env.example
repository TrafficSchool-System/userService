# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/userServiceDb
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_long
JWT_EXPIRATION=86400000

# Email Configuration
SENDGRID_API_KEY=secretApiKey
SENDGRID_FROM_EMAIL=email
SENDGRID_FROM_NAME=Traffic School

# Magic Link Configuration
MAGIC_LINK_EXPIRATION=300000
MAGIC_LINK_BASE_URL=http://localhost:3000/verify

# Eureka
EUREKA_URL=http://localhost:8761/eureka/

# Server
SERVER_PORT=8081

# Service API Key for internal service-to-service communication
# VIKTIGT: Måste vara samma i alla services!
SERVICE_API_KEY=your_service_api_key_change_in_production
